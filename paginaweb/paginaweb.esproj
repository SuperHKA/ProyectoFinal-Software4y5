<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.3864779">
  <PropertyGroup>
    <!-- Usar npm run dev que ya está configurado en package.json -->
    <StartupCommand>npm run dev</StartupCommand>
    <JavaScriptTestRoot>PaginaWeb\</JavaScriptTestRoot>
    <JavaScriptTestFramework>None</JavaScriptTestFramework>
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\PaginaWeb\html</BuildOutputFolder>
    <!-- Working directory debe ser PaginaWeb -->
    <WorkingDirectory>$(MSBuildProjectDirectory)\PaginaWeb/html</WorkingDirectory>
    <BuildCommand>npm run dev || npx serve PaginaWeb/html</BuildCommand>
    <StartupCommandWorkingDirectory>C:\Visual Studio Projects\ProyectoFinal-Software-4-y-5\paginaweb\PaginaWeb</StartupCommandWorkingDirectory>
    <PackageJsonDirectory>C:\Visual Studio Projects\ProyectoFinal-Software-4-y-5\paginaweb</PackageJsonDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Remove=".vscode\**" />
    <None Remove="node_modules\**" />
    <None Remove="PaginaWebReact\**" />
    <None Remove="PaginaWeb\.idea\**" />
    <TypeScriptConfiguration Remove=".vscode\**" />
    <TypeScriptConfiguration Remove="node_modules\**" />
    <!-- Incluir todos los archivos de PaginaWeb -->
    <TypeScriptConfiguration Remove="PaginaWebReact\**" />
    <TypeScriptConfiguration Remove="PaginaWeb\.idea\**" />
    <None Include="PaginaWeb\**\*" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="PaginaWeb\.idea\.gitignore" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\.gitignore" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\.name" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\copilot.data.migration.agent.xml" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\copilot.data.migration.ask.xml" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\copilot.data.migration.ask2agent.xml" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\copilot.data.migration.edit.xml" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\discord.xml" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\encodings.xml" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\indexLayout.xml" />
    <None Remove="PaginaWeb\.idea\.idea.ProyectoFinal-Software-4-y-5\.idea\vcs.xml" />
    <None Remove="PaginaWeb\.idea\copilot.data.migration.agent.xml" />
    <None Remove="PaginaWeb\.idea\copilot.data.migration.ask.xml" />
    <None Remove="PaginaWeb\.idea\copilot.data.migration.ask2agent.xml" />
    <None Remove="PaginaWeb\.idea\copilot.data.migration.edit.xml" />
    <None Remove="PaginaWeb\.idea\misc.xml" />
    <None Remove="PaginaWeb\.idea\modules.xml" />
    <None Remove="PaginaWeb\.idea\vcs.xml" />
  </ItemGroup>
</Project>